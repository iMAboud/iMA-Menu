theme
{
  name = "modern"
  view = view.medium
  dark = true
  border.enabled = true
  border.size = 2
  border.color = #ff1a2e
  border.opacity = 45
  border.radius = 4
  image.enabled = true
  image.color = [#ff1a2e, #ffffff]
  background.color = #0a0406
  background.opacity = 100
  background.effect = 0
  item.opacity = 0
  item.radius = 4
  item.text.normal = #f5f5f7
  item.text.select = #ffffff
  item.text.normal.disabled = #6e5559
  item.text.select.disabled = #6e5559
  item.back.select = #e50914
  item.back.select.disabled = #0a0406
  item.border.normal = default
  item.border.normal.disabled = #0a0406
  item.border.select = #ff3b4e
  item.border.select.disabled = #0a0406
  font.size = auto
  font.name = "Segoe UI Variable Text"
  font.weight = true
  font.italic = false
  shadow.enabled = true
  shadow.size = 6
  shadow.opacity = 50
  shadow.color = #ff1a2e
  separator.size = 1
  separator.color = #2b0b12
  separator.opacity = 50
  symbol.normal = #ff1a2e
  symbol.select = #ffffff
  symbol.normal.disabled = #6e5559
  symbol.select.disabled = #ffffff
  item.back.normal = #0a0406
  item.back.normal.disabled = #0a0406
  border.padding.top = 5
  border.padding.bottom = 5
  border.padding.left = 0
  border.padding.right = 0
}
